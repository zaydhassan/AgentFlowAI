# syntax=docker/dockerfile:1.7
# =============================================================================
# AgentFlow AI — backend worker image (BullMQ memory-embedding worker).
#
# AgentFlow AI has no separate FastAPI/Python service — it is a Next.js
# monolith. This "backend" Dockerfile containerizes the background-processing
# worker instead. The worker handler (lib/queue/workers/memory-embedding) is
# imported by instrumentation.ts during Next's server boot; the worker code is
# therefore only reachable through Next's standalone server bundle. So the
# dedicated worker container runs the SAME standalone server as the web image,
# but with QUEUE_WORKER_AUTOSTART=true so instrumentation.ts starts the
# memory-embedding worker in-process. Its HTTP port is NOT published — it
# exists only to host the worker (and to answer the liveness healthcheck).
#
# Multi-stage: base → deps → builder → (dev | runner).
# Build with: docker build -f Dockerfile.backend --target runner -t agentflow-ai-worker .
# =============================================================================

ARG NODE_VERSION=20-bookworm-slim

# ---------- base — shared foundation (openssl for the Prisma engine) ----------
FROM node:${NODE_VERSION} AS base
WORKDIR /app
RUN apt-get update \
  && apt-get install -y --no-install-recommends openssl ca-certificates \
  && rm -rf /var/lib/apt/lists/*
ENV NEXT_TELEMETRY_DISABLED=1

# ---------- deps — install all deps + generate Prisma client ------------------
FROM base AS deps
COPY package.json package-lock.json* ./
COPY prisma ./prisma
RUN npm ci \
  && npx prisma generate \
  && npm cache clean --force

# ---------- builder — compile the production standalone build ------------------
FROM deps AS builder
COPY . .
ARG NEXT_PUBLIC_APP_URL=http://localhost:3000
ENV NEXT_PUBLIC_APP_URL=${NEXT_PUBLIC_APP_URL}
RUN npm run build

# ---------- dev — live-reload dev worker --------------------------------------
# Used by `docker compose --profile worker up` (dev) when you want a dedicated
# worker container instead of the in-process worker the web container starts.
FROM deps AS dev
COPY . .
ENV NODE_ENV=development \
    QUEUE_WORKER_AUTOSTART=true \
    WATCHPACK_POLLING=true \
    CHOKIDAR_USEPOLLING=true
CMD ["sh", "-c", "npx prisma generate && npm run dev"]

# ---------- runner — minimal production worker image (non-root) ---------------
FROM base AS runner
ENV NODE_ENV=production \
    PORT=3000 \
    HOSTNAME=0.0.0.0 \
    # Worker mode: instrumentation.ts starts the memory-embedding worker.
    QUEUE_WORKER_AUTOSTART=true
RUN groupadd --system --gid 1001 nodejs \
  && useradd --system --uid 1001 --gid nodejs --home-dir /app nextjs

WORKDIR /app
COPY --from=builder --chown=nextjs:nodejs /app/.next/standalone ./
COPY --from=builder --chown=nextjs:nodejs /app/.next/static ./.next/static
COPY --from=builder --chown=nextjs:nodejs /app/public ./public
# Prisma (the worker writes embedding vectors back to Postgres via Prisma).
COPY --from=builder --chown=nextjs:nodejs /app/prisma ./prisma
COPY --from=builder --chown=nextjs:nodejs /app/node_modules/.prisma ./node_modules/.prisma
COPY --from=builder --chown=nextjs:nodejs /app/node_modules/@prisma/client ./node_modules/@prisma/client

USER nextjs
# No EXPOSE — the port is internal-only (hosting the worker + healthcheck).
HEALTHCHECK --interval=30s --timeout=5s --start-period=30s --retries=3 \
  CMD node -e "fetch('http://127.0.0.1:3000/api/health/live').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"
CMD ["node", "server.js"]
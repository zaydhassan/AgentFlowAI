# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Local pgvector install staging (third-party Windows binary, not for commit)
.pgvector-staging/

# User-uploaded content (profile photos, etc.) — runtime-generated, not for commit
/public/uploads/

# Local dev email spool (lib/resend writes outbound emails here when no
# RESEND_API_KEY is set). Runtime-generated, may contain personal data.
/tmp/

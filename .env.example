# =============================================================================
# AgentFlow AI — Environment Variables
# Copy to .env and fill in real values.
# =============================================================================

# --- Database ---------------------------------------------------------------
# Provision a Postgres database (Neon / Supabase / Vercel Postgres / local).
# Example: postgresql://user:password@host:5432/dbname
DATABASE_URL=

AUTH_SECRET=
# Optional. Auto-detected on Vercel. Set explicitly for custom domains.
# AUTH_URL=http://localhost:3000

# --- Google OAuth -----------------------------------------------------------
# https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: ${AUTH_URL}/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# --- GitHub OAuth -----------------------------------------------------------
# https://github.com/settings/developers
# Authorization callback URL: ${AUTH_URL}/api/auth/callback/github
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# --- Payment provider ------------------------------------------------------
# Which provider is active. "razorpay" (default) or "stripe". The app talks to
# the active provider through a single PaymentProvider interface; switching is
# a config change. Stripe is retained behind the interface but dormant unless
# set to "stripe".
PAYMENT_PROVIDER=razorpay

# --- Razorpay (active by default) -----------------------------------------
# If the keys are missing, the billing page shows a "not configured" notice and
# checkout returns a 503 — no payments are processed and nothing is simulated.
#
# Key id + secret (server-only; never exposed to the client).
# https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Webhook signing secret from your webhook endpoint.
# Dashboard → Settings → Webhooks → create endpoint → copy the secret.
# Local dev: tunnel with ngrok and point the webhook at
#   https://<your-ngrok>.ngrok.app/api/payments/webhook/razorpay
RAZORPAY_WEBHOOK_SECRET=
# Publishable key id — the checkout.js key_id (safe for the browser).
NEXT_PUBLIC_RAZORPAY_KEY_ID=
# Currency for charges, in the smallest unit (cents/paise). Default "usd" to
# preserve the $29/$99 pricing (requires an international-enabled Razorpay
# account). Set to "inr" for Indian accounts — amounts in PLAN_META are then
# interpreted in that currency's minor units, so pick INR-appropriate prices
# there before enabling inr.
RAZORPAY_CURRENCY=usd
# Optional: pre-created Razorpay Plan ids per plan/interval. If blank, the app
# auto-creates the plans on first checkout and caches them in the PlanPrice
# table. Create plans in the Razorpay dashboard (period monthly/yearly, amount
# 2900/9900 minor units for Pro/Business monthly at USD).
# RAZORPAY_PLAN_PRO_MONTHLY=
# RAZORPAY_PLAN_PRO_YEARLY=
# RAZORPAY_PLAN_BUSINESS_MONTHLY=
# RAZORPAY_PLAN_BUSINESS_YEARLY=

# --- App URL (provider return URLs) ----------------------------------------
# Public base URL used for checkout success/cancel and management return URLs.
# In production set this to your deployed origin. Falls back to APP_URL, then
# to the incoming request origin. Safe to expose to the client.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Trials -----------------------------------------------------------------
# Free-trial length in days for a customer's FIRST subscription. Default 0
# (no trial). A customer who already has/had a subscription never re-trials.
# PAYMENT_TRIAL_DAYS=0

# --- Stripe (inactive unless PAYMENT_PROVIDER=stripe) ----------------------
# Retained for the StripeProvider behind the interface. Only used when
# PAYMENT_PROVIDER=stripe. Webhook endpoint: /api/payments/webhook/stripe
# (local dev: `stripe listen --forward-to localhost:3000/api/payments/webhook/stripe`).
# STRIPE_SECRET_KEY=
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# STRIPE_WEBHOOK_SECRET=
# Per-interval price ids (or leave blank to auto-create):
#   STRIPE_PRICE_PRO_MONTHLY / STRIPE_PRICE_PRO_YEARLY
#   STRIPE_PRICE_BUSINESS_MONTHLY / STRIPE_PRICE_BUSINESS_YEARLY
# Single-name aliases (treated as the monthly price):
#   STRIPE_PRO_PRICE_ID / STRIPE_BUSINESS_PRICE_ID
# Customer Portal: https://dashboard.stripe.com/settings/billing/portal
# STRIPE_TRIAL_DAYS=0

# --- Resend (email) ---------------------------------------------------------
# https://resend.com/api-keys
RESEND_API_KEY=
# "From" address — must be a verified domain in Resend.
RESEND_FROM="AgentFlow AI <noreply@agentflow.ai>"
# Base URL for email links. Defaults to http://localhost:3000 in dev.
# APP_URL=https://app.agentflow.ai

# --- AI (Visual Workflow Builder) -------------------------------------------
# AI Development Mode: if neither OPENAI_API_KEY nor ANTHROPIC_API_KEY is set,
# the Copilot / generate / explain / analyze / recommend features do NOT crash —
# they run on an enhanced deterministic engine (no external calls). Set one
# key to use the real model. Server-only; never exposed to the client.
#
# OpenAI: https://platform.openai.com/api-keys
OPENAI_API_KEY=
# Anthropic: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
# Optional model override. Defaults: gpt-4.1-mini (OpenAI), claude-haiku-4-5 (Anthropic).
# AI_MODEL=

# --- Integrations (Gmail) ---------------------------------------------------
# Provider-agnostic encryption key for OAuth tokens stored at rest (AES-256-GCM).
# Generate with: openssl rand -base64 32
# REQUIRED before connecting any integration — if missing, /settings/integrations
# shows a "not configured" notice and the connect endpoint returns a 503.
INTEGRATIONS_ENCRYPTION_KEY=
# Dedicated Google OAuth client for the Gmail integration (kept separate from
# the AUTH_GOOGLE_* login client). Create an OAuth client in Google Cloud Console,
# enable the Gmail API, and add the authorized redirect URI below.
# Redirect URI: ${NEXT_PUBLIC_APP_URL}/api/integrations/callback
GMAIL_OAUTH_CLIENT_ID=
GMAIL_OAUTH_CLIENT_SECRET=
# Optional override for the OAuth redirect URI (defaults to
# ${NEXT_PUBLIC_APP_URL}/api/integrations/callback). Set this only if your
# console's authorized redirect URI differs.
# GMAIL_OAUTH_REDIRECT_URI=

# --- Memory Engine (Long-Term AI Memory) -----------------------------------
# Master switch. When false, memory-enabled AI nodes skip retrieve/store
# (they still generate a real response). Default true.
# MEMORY_ENABLED=true
# Embedding provider. "openai" today (future: voyage, cohere, local). Reuses
# OPENAI_API_KEY for OpenAI embeddings — no separate key needed.
# MEMORY_EMBEDDING_PROVIDER=openai
# MEMORY_EMBEDDING_MODEL=text-embedding-3-small
# MEMORY_EMBEDDING_DIM=1536
# Retrieval defaults (per recall call).
# MEMORY_TOP_K=5
# MEMORY_SIMILARITY_THRESHOLD=0.75
# If OPENAI_API_KEY is unset, memory features no-op cleanly (no fake embeddings):
# memory-enabled AI nodes log "memory disabled — embeddings not configured" and
# still generate a real response via lib/ai's deterministic fallback.

# --- Cache (Redis caching layer) --------------------------------------------
# lib/cache is a provider-agnostic cache (CacheProvider interface). Resolution:
#   CACHE_ENABLED=false                → no-op cache (every read is a miss)
#   CACHE_ENABLED=true, no REDIS_URL   → in-process LRU+TTL cache (per process)
#   CACHE_ENABLED=true, REDIS_URL set  → Redis (ioredis) with an automatic
#                                        in-memory fallback when Redis is down
# Caches (all additive, none touch their source-of-truth engines):
#   • memory retrievals  — POST /api/memory/search   (30s TTL, per user+query)
#   • workflow metadata  — GET /api/workflows, GET /api/workflows/[id] (60s/90s;
#     invalidated on create/update/delete)
#   • node definitions   — lib/nodes getNodeDef     (in-process 60s TTL memo)
#   • MCP tool discovery — GET /api/mcp/tools, GET /api/mcp/resources (60s TTL)
# Counters (hits/misses/sets/deletes/errors + hit-rate) are exposed via
# cacheSnapshot() / cacheStats() from @/lib/cache. Default true.
# CACHE_ENABLED=true
# Redis connection URL. Leave blank to use the in-process cache instead.
# Local: redis://localhost:6379  •  Upstash/Redis Cloud: rediss://:password@host:6379
# REDIS_URL=
# Default per-entry TTL in seconds (used when a caller doesn't pass one). 60s.
# CACHE_DEFAULT_TTL=60
# Milliseconds to wait for Redis to connect on first use before falling back. 3000.
# CACHE_CONNECT_TIMEOUT_MS=3000

# --- Background Job Queue (BullMQ) ------------------------------------------
# lib/queue is a provider-agnostic job queue (QueueProvider interface) backed
# by BullMQ on the same REDIS_URL as the cache layer. Resolution:
#   QUEUE_ENABLED=false / no REDIS_URL → no-op queue: enqueue() returns
#     { queued: false } and callers (the memory engine) run the work
#     synchronously — graceful fallback, identical to pre-queue behavior.
#   QUEUE_ENABLED=true, REDIS_URL set  → BullMQ. enqueue() returns { queued: false }
#     on a runtime Redis failure too, so a Redis outage never breaks the app.
# Example worker: MemoryEmbeddingWorker (lib/queue/workers/memory-embedding) —
# the memory engine enqueues embedding generation instead of blocking the
# request. Exhausted-retry jobs move to a dead-letter queue (`<queue>:dlq`).
# Metrics (waiting/active/completed/failed/delayed/paused) are exposed via
# queueSnapshot() and GET /api/queue. Default true.
# QUEUE_ENABLED=true
# Reuses the cache's REDIS_URL (no separate var). BullMQ needs its own
# connection (maxRetriesPerRequest: null), so lib/queue keeps its own pool.
# REDIS_URL=redis://localhost:6379
# Milliseconds to wait for the queue Redis connection on first use. 3000.
# QUEUE_CONNECT_TIMEOUT_MS=3000
# Autostart background workers on Next.js server boot (instrumentation.ts).
# Default true (good for dev / a long-lived Node server). Set false in serverless
# prod and run the worker in a dedicated process/container instead.
# QUEUE_WORKER_AUTOSTART=true
# Memory-embedding worker tuning:
#   attempts (configurable retries) — default 5.
# MEMORY_EMBEDDING_ATTEMPTS=5
#   exponential-backoff base delay in ms — default 2000 (2s, 4s, 8s, 16s, 32s).
# MEMORY_EMBEDDING_BACKOFF_MS=2000
#   worker concurrency (parallel embedding calls) — default 4.
# MEMORY_EMBEDDING_CONCURRENCY=4

# --- Rate Limiting (API abuse protection) ------------------------------------
# lib/rate-limit is a provider-agnostic limiter (RateLimiter interface) with a
# Redis backend and an in-memory fallback. Next.js middleware is Edge-only, so
# the cross-cutting enforcement in middleware.ts uses the IN-MEMORY limiter
# (ioredis can't run in the Edge runtime — Redis is "unavailable" there, which
# is the documented fallback). The Redis limiter is the configured default for
# Node contexts (applyRateLimit in route handlers).
# Algorithms: sliding window (default), fixed window, token bucket.
# Identification: IP (middleware), User ID / API Key / Workspace ID (Node guards).
# Default true.
# RATE_LIMIT_ENABLED=true
# Provider: "redis" (default) or "memory". redis falls back to in-memory when
# REDIS_URL is unset or Redis is unreachable.
# RATE_LIMIT_PROVIDER=redis
# Default window (seconds) + limit for the catch-all "public" policy:
# RATE_LIMIT_DEFAULT_WINDOW=60
# RATE_LIMIT_DEFAULT_LIMIT=100
# Per-policy overrides (all optional; spec defaults shown):
#   Authentication       RATE_LIMIT_AUTH_LIMIT=5        (window 60s)
#   AI Completion        RATE_LIMIT_AI_LIMIT=30         (window 60s)
#   Workflow Execution   RATE_LIMIT_WORKFLOW_LIMIT=20   (window 60s)
#   Memory Search        RATE_LIMIT_MEMORY_LIMIT=60     (window 60s)
#   MCP Invocation       RATE_LIMIT_MCP_LIMIT=60        (window 60s)
#   Public APIs          RATE_LIMIT_PUBLIC_LIMIT=100    (window 60s)
#   (e.g. RATE_LIMIT_AI_WINDOW=30 / RATE_LIMIT_AI_LIMIT=100)
# Reuses REDIS_URL (no separate var). Milliseconds to wait for Redis on first
# use before falling back to in-memory. 3000.
# RATE_LIMIT_CONNECT_TIMEOUT_MS=3000

# --- Structured Logging (lib/logger) -----------------------------------------
# lib/logger is the centralized structured logger every backend module uses
# (getLogger / the `logger` default export). JSON (NDJSON) in production,
# pretty colored lines in development. Request-scoped context (requestId,
# userId, workspaceId, workflowId, executionId, agentId, nodeId, provider,
# environment) propagates across `await` via AsyncLocalStorage. The async sink
# flushes on setImmediate (non-blocking); withRequestLogging awaits a flush so
# logs survive a serverless freeze.
# Levels (lowest → highest): trace debug info warn error fatal. Default: debug
# in development, info in production.
# LOG_LEVEL=info
# Output format: "json" or "pretty". Default: pretty in dev, json in production.
# LOG_FORMAT=json
# Boolean convenience override for pretty output (takes precedence over
# LOG_FORMAT). "true" forces pretty, "false" forces json.
# LOG_PRETTY=false

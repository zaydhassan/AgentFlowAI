# =============================================================================
# AgentFlow AI — Environment Variables
# Copy to .env and fill in real values.
# =============================================================================

# --- Database ---------------------------------------------------------------
# Provision a Postgres database (Neon / Supabase / Vercel Postgres / local).
# Example: postgresql://user:password@host:5432/dbname
DATABASE_URL=

AUTH_SECRET=
# Optional. Auto-detected on Vercel. Set explicitly for custom domains.
# AUTH_URL=http://localhost:3000

# --- Google OAuth -----------------------------------------------------------
# https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: ${AUTH_URL}/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# --- GitHub OAuth -----------------------------------------------------------
# https://github.com/settings/developers
# Authorization callback URL: ${AUTH_URL}/api/auth/callback/github
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# --- Stripe -----------------------------------------------------------------
# https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# https://dashboard.stripe.com/webhooks (signing secret)
STRIPE_WEBHOOK_SECRET=
# Create products in Stripe and paste the price IDs here.
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_YEARLY=
STRIPE_PRICE_BUSINESS_MONTHLY=
STRIPE_PRICE_BUSINESS_YEARLY=

# --- Resend (email) ---------------------------------------------------------
# https://resend.com/api-keys
RESEND_API_KEY=
# "From" address — must be a verified domain in Resend.
RESEND_FROM="AgentFlow AI <noreply@agentflow.ai>"
# Base URL for email links. Defaults to http://localhost:3000 in dev.
# APP_URL=https://app.agentflow.ai
